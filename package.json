{
  "name": "tool-hub",
  "description": "做图工具聚合平台 — 工具导航/任务队列/图库",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node electron/main.cjs\" \"vite --port 5175 --strictPort\"",
    "dev:api": "node electron/main.cjs",
    "dev:web": "vite --port 5175 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "gen:likec4": "node scripts/generate-likec4-model.mjs --output likec4/generated.c4 && cd likec4 && npx likec4 validate .",
    "gen:likec4:build": "npm run gen:likec4 && cd likec4 && npx likec4 build . -o dist --base /likec4/ --use-hash-history --title 做图工具聚合平台架构"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "concurrently": "^9.1.2"
  }
}