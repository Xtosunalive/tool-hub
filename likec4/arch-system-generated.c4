        governance_services = component '服务 (30)' {
          description 'anomaly-action-adapter, anomaly-workbench-service, change-disposition-candidate-service, change-disposition-service, decision-evidence-service, dependencies-write-service, dependency-impact-preview-service, document-identity, entity-alias-index, entity-relation-patch-service, entity-repair-service, enums-change-preview-service, enums-write-service, formal-document-node, gap-engine, governance-action-store, inference-conflict-store, inference-decision-consumer, inference-engine, inference-ontology, inference-rule-conflicts, node-id-resolver, ontology-write-service, property-governance-service, property-repair-service, review-action-store, review-status-writer, semantic-architecture-service, unmanaged-entity-candidate-service, version-registry-service'
        }
      }
      publication = component '发布管理' {
        description '批次冻结、隔离暂存、发布门禁和派生数据原子切换'
        publication_routes = component '路由 (1)' {
