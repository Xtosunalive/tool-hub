        }
      }
      analysis = component '架构分析' {
        description '资产查询、影响分析、版本对比和来源回链'
        analysis_routes = component '路由 (6)' {
          description 'architecture-version-routes, article-association-routes, dashboard-routes, kg-routes, obsidian-open-routes, sync-routes'
        }
        analysis_services = component '服务 (7)' {
          description 'architecture-version-service, document-inventory-service, graph-provenance-service, impact-analysis-service, local-operator-context, obsidian-open-service, source-freshness-service'
        }
      }
      shared = component '共享工具' {
