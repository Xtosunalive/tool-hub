      analysis_ui = component '架构分析 前端 (4)' {
        description 'architecture-version, data-dashboard, document-inventory, impact-analysis'
      }
    }

    vault = external 'Obsidian Vault' {
      description '文件系统知识库: TheSchema + wiki/entities'
